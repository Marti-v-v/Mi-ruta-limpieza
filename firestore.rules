rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo la propia persona, con sesión iniciada y correo verificado
    function esSuyo(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // Solo los campos de la app, con tipo y tamaño limitados
    function datosValidos(d) {
      return d.keys().hasOnly(['json', 'email', 'actualizado', 'pin'])
        && (!('json' in d) || (d.json is string && d.json.size() < 500000))
        && (!('email' in d) || d.email == request.auth.token.email)
        && (!('actualizado' in d) || d.actualizado is timestamp)
        && (!('pin' in d) || (d.pin is map
             && d.pin.keys().hasOnly(['s', 'h'])
             && d.pin.s is string && d.pin.s.size() < 64
             && d.pin.h is string && d.pin.h.size() < 64));
    }

    match /usuarios/{uid} {
      allow read, delete: if esSuyo(uid);
      allow create, update: if esSuyo(uid) && datosValidos(request.resource.data);
    }
    // Cualquier otra ruta queda denegada por defecto
  }
}
